# Include all environmental variables to run SDOH Data Discovery Platform locally
# To run the app, run `npm run dev:full` locally after install all packages and check localhost:3000

######
# 1. SOLR & Maptile Endpoints. All variables required.
######

# If you are running Solr locally, the default value should be sufficient. Otherwise, set to `http://<your solr installation>/solr/blacklight-core`.
NEXT_PUBLIC_SOLR_URL='Link_To_DEV_Core'

# Set the API key for MapTiler services. This is used for the basemap style, as well as the geocoding service.
NEXT_PUBLIC_MAPTILER_API_KEY='MapTile_API_Key'

#######
# 2. AI Search Setting
#######
LLM_ENDPOINT="https://api.openai.com/v1/chat/completions" # Required variable. App will use this to identify the LLM provider. Default option is OpenAI
# LLM_ENDPOINT="https://uiuc.chat/api/chat-api/chat" # Enable this if you like to use uiuc.chat, otherwise, keep this disabled

# Required variable. Enter your OpenAI API Key if use OpenAI API. Otherwise, keep it as 'XXX'
OPENAI_API_KEY=XXX 

# Required variable, but you can keep it as XXX if not using uiuc.chat
UIUC_CHAT_API_KEY=XXX 

# Required variable for uiuc.chat project, keep it as it is
COURSE_NAME="SDOH-Place" 

# Required variable. App uses this to identify the model you use. For OpenAI, we use gpt-4o-mini now to balance performance and budget. 
# If you use uiuc.chat, you can try open source models like "Qwen/Qwen2.5-VL-72B-Instruct" or "llama3.1:8b-instruct-fp16"
MODEL_NAME="gpt-4o-mini" 

# Optional. Compare ontology integration strategies for AI search.
# Use one value for both the browser request and the edge function default:
# deterministic = current deterministic HeroP OWL-derived matcher
# prompt = prompt-side ontology context injection
# off = original LLM search without ontology integration
NEXT_PUBLIC_ONTOLOGY_SEARCH_MODE="deterministic"

#######
# 3. Contributor sign-in (Keycloak). Optional: only needed for the data contribution feature.
#######

# Set to "true" to show the Sign In button in the navbar. Anything else hides it.
NEXT_PUBLIC_SHOW_SIGN_IN=false

# Frontend Keycloak client. Issuer is the realm URL, e.g. https://<keycloak host>/realms/<realm>
NEXT_PUBLIC_KEYCLOAK_ISSUER='Keycloak_Realm_URL'
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID='Keycloak_Client_ID'
NEXT_PUBLIC_KEYCLOAK_SCOPE="openid profile email roles"
NEXT_PUBLIC_KEYCLOAK_REQUIRED_ROLE="contributor"
NEXT_PUBLIC_KEYCLOAK_REDIRECT_PATH="/sign-in"
NEXT_PUBLIC_KEYCLOAK_POST_LOGOUT_REDIRECT_PATH="/"

# The Keycloak client must allow these exact URLs (see README, "Keycloak frontend setup").

#######
# 4. Contributor submissions (sdohplace-intake-api). Optional, server-side only.
#######

# Read by the edge function / Next API route, never exposed to the browser.
# Do NOT prefix the token with NEXT_PUBLIC_.
INTAKE_API_BASE_URL="http://localhost:9090"
INTAKE_API_TOKEN="change-me"

# NOTE: NEXT_PUBLIC_* variables are inlined at build time. Restart `npm run dev:full`
# (or rebuild the site on Netlify) after changing them.
